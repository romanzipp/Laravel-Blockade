{
    "name": "romanzipp/laravel-blockade",
    "description": "Laravel Blockade package",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "romanzipp",
            "email": "ich@ich.wtf",
            "homepage": "https://ich.wtf"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/url": "^2.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "laravel/framework": "^12.0|^13.0",
        "mockery/mockery": "^1.6.10",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "romanzipp/php-cs-fixer-config": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "romanzipp\\Blockade\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "romanzipp\\Blockade\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/php-cs-fixer fix"
    },
    "extra": {
        "laravel": {
            "providers": [
                "romanzipp\\Blockade\\Providers\\BlockadeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
